# ===========================================
# SIEM/SOC Integration Configuration
# ===========================================

# Sentry Configuration for SIEM/SOC
SENTRY_ENABLED=true
SENTRY_DSN=https://your-dsn-here@sentry.io/project-id
SENTRY_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_DEBUG=false

# Security Monitoring Configuration
SECURITY_MONITORING_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW_MS=900000
SECURITY_RATE_LIMIT_MAX_REQUESTS=100
SECURITY_STRICT_RATE_LIMIT_MAX=10

# Data Classification
DEFAULT_DATA_CLASSIFICATION=internal
SENSITIVE_ENDPOINT_DATA_CLASSIFICATION=restricted

# SIEM/SOC Compliance Settings
COMPLIANCE_FRAMEWORKS=PCI-DSS,GDPR,SOX
DATA_RETENTION_DAYS=2555
SECURITY_EVENT_RETENTION_DAYS=2555

# IP Reputation Monitoring
IP_REPUTATION_CHECK_ENABLED=true
SUSPICIOUS_IP_DETECTION_ENABLED=true

# Anomaly Detection
ANOMALY_DETECTION_ENABLED=true
SQL_INJECTION_DETECTION_ENABLED=true
XSS_DETECTION_ENABLED=true

# Security Event Thresholds
CRITICAL_EVENT_THRESHOLD=1
HIGH_EVENT_THRESHOLD=5
MEDIUM_EVENT_THRESHOLD=20
LOW_EVENT_THRESHOLD=100

